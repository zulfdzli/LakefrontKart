{
  "name": "turbo-karts",
  "private": true,
  "type": "module",
  "description": "Local multiplayer kart racer: one host screen, phones as controllers.",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "shared",
    "server",
    "host",
    "controller"
  ],
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/src/index.ts",
    "build": "vite build",
    "start": "tsx server/src/index.ts --prod",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sim-report": "tsx tools/sim-report.ts",
    "capture": "tsx tools/capture.ts",
    "bots": "tsx tools/bots.ts",
    "icons": "tsx tools/gen-icons.ts",
    "e2e": "tsx tools/e2e.ts",
    "track-view": "tsx tools/track-view.ts",
    "textures": "tsx tools/gen-textures.ts",
    "car-sheet": "tsx tools/car-sheet.ts",
    "perf": "tsx tools/perf.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "playwright-core": "^1.49.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
